# 封闭 Beta（Docker + Tailscale）部署模板。
# 复制为 .env 后填入真实 Key；该文件已被 .gitignore 忽略，绝不提交。

LLM_PROVIDER=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=请替换为真实的DeepSeek_API_Key
DEEPSEEK_MODEL=deepseek-chat

# 容器内的持久化目录。compose.yaml 将宿主机 ./data 挂载到 /app/data。
SESSION_DIR=/app/data/sessions
KNOWLEDGE_DIR=/app/data/knowledge
MCP_ALLOWED_DIR=/app/data/mcp_workspace
LOG_DIR=/app/data/logs

# 文件系统 MCP 会在服务器上产生读写副作用；封闭 Beta 先关闭。
MCP_ENABLED=false

# 多模态请求边界：最多 3 张、每张最大 3 MiB（解码后）。
MAX_IMAGES_PER_MESSAGE=3
MAX_IMAGE_BYTES=3145728

# 单进程限流不作为 Tailscale 私有网络的主防线，保持关闭。
# 如果未来改为公网访问，必须在反向代理层启用限流、认证和 HTTPS，再单独评审。
AUTH_TOKEN=
RATE_LIMIT_RPM=0

REQUEST_TIMEOUT=90
MAX_RETRIES=3
DEADLINE=30
BREAKER_FAILURE_THRESHOLD=3
BREAKER_OPEN_SECONDS=30
LOG_LEVEL=INFO
