# 封闭 Beta（Docker + Tailscale）部署模板。
# 复制为 .env 后填入真实 Key；该文件已被 .gitignore 忽略，绝不提交。

LLM_PROVIDER=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=请替换为真实的DeepSeek_API_Key
DEEPSEEK_MODEL=deepseek-chat

# Agent 的确定性报时使用此时区，不依赖容器默认时区。
TIME_ZONE=Asia/Shanghai

# Docker Hub 在部分大陆网络不可直连时，构建阶段使用已验证的镜像代理。
# 此变量只供 Docker Compose 解析，Pydantic 会忽略它，不会传入应用逻辑。
PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.12-slim

# 容器内的持久化目录。compose.yaml 将宿主机 ./data 挂载到 /app/data。
SESSION_DIR=/app/data/sessions
KNOWLEDGE_DIR=/app/data/knowledge
MCP_ALLOWED_DIR=/app/data/mcp_workspace
LOG_DIR=/app/data/logs

# 文件系统 MCP 会在服务器上产生读写副作用；封闭 Beta 先关闭。
MCP_ENABLED=false

# 多模态请求边界：最多 3 张、每张最大 3 MiB（解码后）。
MAX_IMAGES_PER_MESSAGE=3
MAX_IMAGE_BYTES=3145728

# 单进程限流不作为 Tailscale 私有网络的主防线，保持关闭。
# 如果未来改为公网访问，必须在反向代理层启用限流、认证和 HTTPS，再单独评审。
AUTH_TOKEN=
RATE_LIMIT_RPM=0

# M10 账户体系：启用后首次由服务器所有者使用邀请码注册。
ACCOUNT_ENABLED=true
REGISTRATION_INVITE_CODE=请替换为随机且足够长的邀请码
AUTH_DATABASE=/app/data/auth.db
AUTH_SESSION_HOURS=168

REQUEST_TIMEOUT=90
MAX_RETRIES=3
DEADLINE=30
BREAKER_FAILURE_THRESHOLD=3
BREAKER_OPEN_SECONDS=30
LOG_LEVEL=INFO
