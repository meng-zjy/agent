# ===== 供应商配置 =====
# 复制本文件为 .env 并填入真实 API Key（.env 已被 .gitignore 忽略，不会提交）

# 当前用哪家：deepseek（默认） / sensenova
LLM_PROVIDER=deepseek

# ----- DeepSeek（默认）-----
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=sk-请替换为你的真实Key
# deepseek-chat        默认：非 reasoning，首 token 约 0.6s，真逐 token 流式，无空回复
# deepseek-flash       支持视觉（base64 图片），但仍是 reasoning 模型（见下面 MAX_TOKENS 提示）
# deepseek-v4-pro      不支持视觉，首段答案实测要等 37s，不适合对话
DEEPSEEK_MODEL=deepseek-chat

# ----- 商汤日日新（备选，LLM_PROVIDER=sensenova 时启用）-----
# 已从默认切走：服务端「先把整段算完再一次性下发」，50 字提问首 token 等 62.8s；
# 且 sensenova-6.8-flash-lite 是 reasoning 模型，max_tokens=4096 也会被思考全吃掉 → 空回复。
# 细节见 docs/14。
SENSENOVA_BASE_URL=https://token.sensenova.cn/v1
SENSENOVA_API_KEY=sk-（可选：只在 LLM_PROVIDER=sensenova 时需要）
SENSENOVA_MODEL=sensenova-6.8-flash-lite

# ===== 可选生成参数（留空则使用模型默认值）=====
# MAX_TOKENS=4096
# TEMPERATURE=0.7
#
# ⚠ 关于 MAX_TOKENS，先分清你在用哪一类模型（实测，见 docs/14）：
#
# 非 reasoning 模型（deepseek-chat）：
#   max_tokens=30  → finish_reason='length'，但答案是「被截断的半句话」，不是空回复。
#   结论：怎么设都不会空回复，想省额度可以设低一点。
#
# reasoning 模型（sensenova-6.8-flash-lite / deepseek-v4-pro / deepseek-flash /
# deepseek-reasoner）：
#   输出分 reasoning（思考）和 content（答案），两者共用 completion_tokens 预算。
#   max_tokens 小于思考量时，思考吃掉全部预算 → content 为空 → 空回复（finish_reason='length'）。
#   实测 deepseek-v4-pro / deepseek-flash / deepseek-reasoner：max_tokens=120 →
#   completion_tokens=120 且 reasoning_tokens=120，content 为空。
#   实测 sensenova-6.8-flash-lite：max_tokens=4096 → reasoning_tokens=4096，content 为空。
#   而且思考消耗是服务端随机抖动的（sensenova 实测同一句提问从 70 跑到 8533），
#   所以**建议留空**，让服务端用它自己的默认上限；显式设一个较低值反而更容易空回复。

# ===== 记忆 / 会话（可选，以下均为默认值）=====
# 会话历史存放目录（JSON 文件，已 gitignore）
# SESSION_DIR=data/sessions

# 系统提示词（角色设定，空字符串则不发送）
# SYSTEM_PROMPT=你是一个 AI 助手，请用中文简洁友好地回答用户。

# 历史截断：最多保留最近几轮对话（0 = 不限制轮数）
# MAX_HISTORY_TURNS=20
# 历史截断：发给模型的上下文最多多少字符（超出丢最旧）
# MAX_HISTORY_CHARS=10000

# ===== 长对话摘要（可选，09）=====
# 保留最近几轮的完整消息，更早的让 LLM 压成滚动摘要。0 = 关闭摘要（回到纯截断）
# SUMMARY_KEEP_TURNS=20
# 摘要长度上限（字符），LLM 输出过长时截断兜底
# SUMMARY_MAX_CHARS=1500

# 注意：SUMMARY_KEEP_TURNS 不能小于 MAX_HISTORY_TURNS。
# 配成前者更大时，ChatService 会悄悄把 MAX_HISTORY_TURNS 抬到 SUMMARY_KEEP_TURNS——
# 否则"还没进摘要、又被截断"的中间那几轮会被静默丢掉。

# ===== 知识库 / RAG（可选，M4）=====
# 放 .txt / .md 文档的目录，启动时自动摄入
# KNOWLEDGE_DIR=data/knowledge
# 文档切块大小（字符）
# CHUNK_SIZE=400
# 切块重叠（字符）
# CHUNK_OVERLAP=50
# 检索返回片段数
# RETRIEVAL_TOP_K=4
# 本地向量化模型（首次运行自动下载，约 100MB，走 hf-mirror.com）
# EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ===== MCP 外部工具（可选，M5）=====
# 是否连接 MCP 工具。开发时可开启；公网/多人环境建议显式设为 false，避免模型触发
# 服务器端文件读写等副作用。封闭 Beta 模板默认关闭。
# MCP_ENABLED=true
# MCP 服务器启动命令。没装 Node.js 时会自动降级为无 MCP 工具，聊天照常
# MCP_SERVER_COMMAND=npx
# MCP 服务器参数（filesystem 服务器授权目录跟在最后，见 MCP_ALLOWED_DIR）
# MCP_SERVER_ARGS=-y @modelcontextprotocol/server-filesystem
# filesystem 授权目录，模型无法读写该目录以外
# MCP_ALLOWED_DIR=data/mcp_workspace

# ===== 多模态图片输入（可选，M6）=====
# 服务端校验；前端限制仅用于即时反馈。图片不会落盘，但会占用内存和模型输入额度。
# MAX_IMAGES_PER_MESSAGE=3
# MAX_IMAGE_BYTES=3145728

# ===== 请求边界（可选，M9）=====
# HTTP read 超时秒数。openai SDK 默认是 600（10 分钟）——那意味着本地也会卡
# 那么久才报错。90 秒比实测最慢的真实响应（78s）多 15% 余量，见 docs/11 §7 发现四
# REQUEST_TIMEOUT=90

# 一次调用的重试次数。openai SDK 自带重试已在代码里关掉（max_retries=0），
# 重试策略只留我们这一份——两层叠着跑、退避节奏互不知道，实测 3×3=9 次 HTTP
# 请求，read=90 时单次调用最坏占住线程 820s ≈ 13.7 分钟
# MAX_RETRIES=3

# 一次调用（**含所有重试**）的墙钟上限。read 超时按「剩余预算」收窄，所以整条
# 调用链被这个值封顶，不再是「重试次数 × 单次超时」线性放大。预算用完抛
# DeadlineExceeded，不再继续试
#
# ⚠ 取舍：实测中位 4.78~7.62s，但出现过 78.14s 的长尾（reasoning=8533）。
#   设 30 意味着那种长尾请求会被掐断。嫌短可以改大，但别回到 90 以上——
#   那等于回到「一次调用占住线程十几分钟」的老问题。
#   注意 deadline < REQUEST_TIMEOUT 时，第一次尝试的 read 超时也会被它收窄
# DEADLINE=30

# 熔断器：上游连续失败 N 次 → 打开 T 秒 → 期间的请求秒级失败，不再重复烧预算。
# 重试治「偶发抖动」，熔断治「上游真的挂了」——上游挂掉时每个请求都各烧一遍
# 完整预算，uvicorn 线程池被占满，连 /health 都被拖到探活超时
# 阈值配 0 = 关闭熔断（每次失败都照常重试）
# BREAKER_FAILURE_THRESHOLD=3
# BREAKER_OPEN_SECONDS=30

# 单次输入上限（字符）。挡住"把整个文档粘进聊天框"烧 token / 撑爆上下文。
# 要处理长文档，请放进 data/knowledge/ 走知识库检索，不要塞进聊天框
# MAX_INPUT_CHARS=32000

# ===== 访问控制（可选，M9）=====
# ⚠ 本项目默认绑 127.0.0.1，本地**没有攻击面**。下面两项留空 / 为 0 时，
#   行为与"没装这个中间件"完全一致（测试里有锁住这一点）。
#   写它们是为了掌握中间件的写法，不是在真防护——见 docs/13 §4.6。
# 认证令牌：非空时所有请求必须带 `X-Agent-Token: <值>`；/health 除外（探活不能挡）
# AUTH_TOKEN=
# 速率限制：每 IP 每分钟最多多少请求，0 = 关闭。计数在内存里，多进程部署各算各的
# RATE_LIMIT_RPM=0

# ===== 日志（可选，M8）=====
# 级别：DEBUG / INFO / WARNING / ERROR
# 日志只记元数据（耗时/结果/错误），不记消息正文——会话历史已落盘到 data/sessions/
# LOG_LEVEL=INFO
# 日志目录（agent.log + 轮转文件，已 gitignore）
# LOG_DIR=data/logs
